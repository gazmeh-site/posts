# =============================================================================
# mirza/.env — full template of every supported environment variable.
# Copy this file to mirza/.env and fill in real values:
#   cp .example.env .env
# =============================================================================

# --- Shared text-model defaults (apply to every stage) -------------------------
# Model name in litellm "provider/model" form; if you omit the provider prefix,
# "anthropic/" is assumed automatically.
#   Examples: opus | claude-opus-5 | anthropic/claude-sonnet-5 | gemini/gemini-2.5-flash
# Use exactly the model name your gateway accepts (for 9router: opus).
MIRZA_MODEL=opus
# API key, as your gateway expects it (for 9router, the same x-api-key as in curl).
MIRZA_API_KEY=sk-your-api-key
# Provider base URL — bare host; litellm appends /v1/messages itself.
MIRZA_API_BASE=your-base-url
# max_tokens ceiling for responses. Defaults to 32000 because a full Persian
# article must fit inside a single JSON field; raise it if responses get cut off.
# MIRZA_MAX_TOKENS=32000

# --- Prefill --------------------------------------------------------------------
# To force JSON output, mirza prefills the assistant turn with "{" (prefill).
# Some gateways (e.g. 9router) reject it:
#   "This model does not support assistant message prefill"
# Set false in that case — JSON extraction in llm.py handles both shapes.
MIRZA_PREFILL=false

# --- Per-stage overrides (optional) ----------------------------------------------
# There are four stages: DRAFT / ENRICH / METADATA / IMAGES.
# You can set any of these fields per stage; unset fields inherit the shared
# defaults above:
#   MIRZA_<STAGE>_MODEL        litellm model name for this stage
#   MIRZA_<STAGE>_API_KEY      stage-specific API key
#   MIRZA_<STAGE>_API_BASE     stage-specific base URL
#   MIRZA_<STAGE>_TEMPERATURE  sampling temperature (defaults: draft=0.3 enrich=0.2 metadata=0.2 images=0.8)
#   MIRZA_<STAGE>_EFFORT       reasoning effort: none | low | medium | high
#                              (defaults: only enrich=medium, the rest none)
#   MIRZA_<STAGE>_MAX_TOKENS   stage-specific token ceiling
# Example — cheap model for draft, strong model only for enrich:
# MIRZA_DRAFT_MODEL=sonnet
# MIRZA_DRAFT_TEMPERATURE=0.3
# MIRZA_DRAFT_EFFORT=none
# MIRZA_DRAFT_MAX_TOKENS=32000
# MIRZA_DRAFT_API_KEY=sk-your-api-key
# MIRZA_DRAFT_API_BASE=https://api.testenghub.com:8443
# MIRZA_ENRICH_MODEL=opus
# MIRZA_ENRICH_EFFORT=high
# MIRZA_METADATA_MODEL=sonnet
# MIRZA_IMAGES_MODEL=sonnet

# --- Legacy fallbacks (backward compatibility) -------------------------------------
# If no MIRZA_* variable is set, these are used as defaults instead:
# ANTHROPIC_MODEL=opus
# ANTHROPIC_API_KEY=sk-your-api-key
# ANTHROPIC_BASE_URL=https://api.testenghub.com:8443
# ANTHROPIC_API_URL=          # alternative to ANTHROPIC_BASE_URL
# ANTHROPIC_MAX_TOKENS=32000

# --- Image generation (Gemini — separate from the text model) ---------------------
# Cover/card images are always generated through the Gemini REST API, regardless
# of which text provider each stage uses. If unset, image generation is skipped
# gracefully and the rest of the pipeline still runs.
# GEMINI_API_KEY=your-gemini-key
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image-preview

# --- LangSmith tracing (optional) ---------------------------------------------------
# When LANGSMITH_TRACING=true and a key is set, the LangGraph pipeline is traced
# automatically. If the key is missing, tracing is forced off so runs don't fail
# with auth errors.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_pt_...
# LANGSMITH_PROJECT=mirza
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com

# =============================================================================
# Note: STRAPI_URL and STRAPI_TOKEN belong to the sync scripts in posts/ and are
# read from posts/.env, not here — set them there.
# =============================================================================
